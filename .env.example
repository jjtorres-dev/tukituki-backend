NODE_ENV=development

APP_NAME=TukiTuki Backend
PORT=3001
API_PREFIX=api/v1
ADMIN_WEB_ORIGIN=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true
REQUEST_BODY_LIMIT=1mb
TRUST_PROXY_HOPS=1
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_BLOCK_DURATION_MS=60000
LOG_FORMAT=pretty
LOG_LEVEL=fatal,error,warn,log

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=tukituki
DATABASE_USER=tukituki
DATABASE_PASSWORD=change_me
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# CA PEM codificada en Base64; dejar vacía si el proveedor usa una CA pública.
DATABASE_SSL_CA_BASE64=

REDIS_HOST=localhost
REDIS_PORT=6379

OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_HASH_SECRET=change-this-otp-hash-secret
# NUNCA true cuando NODE_ENV=production (el Backend no arranca si se hace).
OTP_DEBUG_ENABLED=false
# Límites dedicados de POST /auth/otp/request (ventana larga, protección de costo)
OTP_REQUEST_IP_LIMIT=20
OTP_REQUEST_IP_WINDOW_SECONDS=3600
OTP_REQUEST_PHONE_LIMIT=5
OTP_REQUEST_PHONE_WINDOW_SECONDS=3600

JWT_ACCESS_SECRET=change-this-access-secret
JWT_ACCESS_TTL_SECONDS=900

# Seguridad reforzada del acceso administrativo. Si se omite el secreto,
# se deriva de JWT_ACCESS_SECRET con separación de dominio.
LOGIN_SECURITY_SECRET=change-this-admin-login-security-secret
ADMIN_LOGIN_WINDOW_SECONDS=900
ADMIN_LOGIN_ACCOUNT_MAX_FAILURES=5
ADMIN_LOGIN_IP_MAX_ATTEMPTS=30
ADMIN_LOGIN_BLOCK_SECONDS=900

REFRESH_TOKEN_TTL_SECONDS=2592000

SUPER_ADMIN_PHONE_E164=+51999999999
SUPER_ADMIN_PASSWORD=change-this-secure-password
RIDE_START_CODE_SECRET=replace-with-a-random-secret-of-at-least-32-characters
RIDE_START_CODE_TTL_SECONDS=900
RIDE_START_CODE_MAX_ATTEMPTS=5
RIDE_START_CODE_MAX_REGENERATIONS=3

RIDE_FINAL_FARE_MAX_INCREASE_PERCENT=20

# Workers y outbox
WORKERS_ENABLED=true
RIDE_DISPATCH_POLL_INTERVAL_MS=2000
RIDE_DISPATCH_BATCH_SIZE=25
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_LOCK_TIMEOUT_SECONDS=60

# Firebase Cloud Messaging HTTP v1
# Mantener FCM_ENABLED=false hasta configurar el proyecto Firebase.
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Cancelaciones avanzadas y no-show
PASSENGER_CANCELLATION_GRACE_SECONDS=60
PASSENGER_NO_SHOW_WAIT_SECONDS=300
DRIVER_NO_PROGRESS_SECONDS=180
DRIVER_NO_PROGRESS_MIN_METERS=100
CANCELLATION_FEE_ASSIGNED_PEN=1.00
CANCELLATION_FEE_ARRIVING_PEN=1.50
CANCELLATION_FEE_ARRIVED_PEN=2.00
PASSENGER_NO_SHOW_FEE_PEN=2.50
DRIVER_NO_SHOW_COMPENSATION_PEN=1.50

# Seguridad, SOS y viaje compartido
PUBLIC_APP_ORIGIN=http://localhost:3000
RIDE_SHARE_DEFAULT_TTL_MINUTES=120
RIDE_SHARE_MAX_TTL_MINUTES=1440
RIDE_SHARE_RATE_LIMIT_MAX=60
RIDE_SHARE_RATE_LIMIT_WINDOW_SECONDS=600
SAFETY_INCIDENT_RECENT_RIDE_GRACE_SECONDS=3600
SAFETY_LOCATION_MAX_DISTANCE_METERS=20000
# Pasarela digital Izipay (mantener deshabilitada hasta recibir credenciales)
PUBLIC_API_ORIGIN=http://localhost:3001
IZIPAY_ENABLED=false
IZIPAY_MERCHANT_CODE=
IZIPAY_API_KEY=
IZIPAY_KEY_HASH=
IZIPAY_PUBLIC_KEY=
IZIPAY_TOKEN_SESSION_URL=https://sandbox-api-pw.izipay.pe/security/v1/Token/Generate
IZIPAY_API_KEY_HEADER=X-Api-Key
IZIPAY_CHECKOUT_SCRIPT_URL=https://sandbox-checkout.izipay.pe/payments/v1/js/index.js
IZIPAY_SESSION_TTL_SECONDS=900

GOOGLE_ROUTES_API_KEY=
GOOGLE_ROUTES_BASE_URL=https://routes.googleapis.com
GOOGLE_ROUTES_TRAVEL_MODE=DRIVE
GOOGLE_ROUTES_ROUTING_PREFERENCE=TRAFFIC_UNAWARE
GOOGLE_ROUTES_TIMEOUT_MS=5000

# Límite dedicado de GET /fares/origin-address, por pasajero (ventana larga, protección de costo)
ORIGIN_ADDRESS_RATE_LIMIT_MAX=30
ORIGIN_ADDRESS_RATE_LIMIT_WINDOW_SECONDS=3600

REDIS_URL=

# Railway Storage Buckets (S3-compatible) - STORAGE-R2
# Mantener STORAGE_ENABLED=false hasta configurar el bucket real.
STORAGE_ENABLED=false
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_UPLOAD_URL_TTL_SECONDS=300
STORAGE_DOWNLOAD_URL_TTL_SECONDS=900
STORAGE_MAX_IMAGE_SIZE_BYTES=8388608
STORAGE_MAX_PDF_SIZE_BYTES=10485760
# Secreto para firmar los capability tokens de avatares (STORAGE-R2.1).
STORAGE_AVATAR_TOKEN_SECRET=replace-with-a-random-secret-of-at-least-32-characters
STORAGE_AVATAR_TOKEN_TTL_SECONDS=900